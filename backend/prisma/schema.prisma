generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Models ───────────────────────────────────────────────────

model session {
  sid    String   @id @db.VarChar(258)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  LEAD
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  ENGINEERING
  RESEARCH
  HYBRID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  SUBTASK_ADDED
  DEPENDENCY_ADDED
  MILESTONE_CREATED
  MILESTONE_COMPLETED
  PROJECT_UPDATED
  RECURRING_SPAWNED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationTargetType {
  CHANNEL
  DM
  GROUP_DM
}

enum TaskProgress {
  NO_PROGRESS
  IN_PROGRESS
  COMPLETED
}

enum MilestoneStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_DUE_SOON
  TASK_OVERDUE
  MILESTONE_COMPLETED
  MILESTONE_AT_RISK
  PROJECT_UPDATE
  STANDUP_POSTED
  COMMENT_REPLY
  SYSTEM
  GITHUB_PR_REVIEW_REQUESTED
  GITHUB_PR_MERGED
  GITHUB_CI_FAILED
}

// ── Models ───────────────────────────────────────────────────

model Member {
  id                      String               @id @default(cuid())
  slackId                 String               @unique
  slackHandle             String
  displayName             String
  avatarUrl               String?
  title                   String?
  email                   String?
  timezone                String?
  team                    String?
  bio                     String?
  role                    Role                 @default(MEMBER)
  isAdmin                 Boolean              @default(false)
  isBot                   Boolean              @default(false)
  kanbanColumnOrder       String[]             @default(["TODO", "IN_PROGRESS", "BLOCKED", "DONE"])
  notificationPrefs       String[]             @default(["daily_reminders", "weekly_digest", "project_updates"])
  notificationChannels    Json?
  quietHoursStart         Int?
  quietHoursEnd           Int?
  mutedProjectIds         String[]             @default([])
  tasks                   Task[]               @relation("TaskAssignees")
  createdTasks            Task[]               @relation("TaskCreator")
  archivedTasks           Task[]               @relation("TaskArchiver")
  assignedBlockers        Blocker[]            @relation("BlockerAssignee")
  projects                ProjectMember[]
  comments                TaskComment[]
  activities              Activity[]
  notifications           Notification[]       @relation("NotificationRecipient")
  sentNotifications       Notification[]       @relation("NotificationActor")
  activityLogs            ActivityLog[]
  ownedMilestones         Milestone[]          @relation("MilestoneOwner")
  timeLogs                TimeLog[]
  updates                 ProjectUpdate[]
  organizedEvents         Event[]              @relation("EventOrganizer")
  attendedEvents          Event[]              @relation("EventAttendees")
  rsvps                   EventRsvp[]          @relation("MemberRsvps")
  submissions             OutreachSubmission[] @relation("SubmissionAuthor")
  reviewedSubmissions     OutreachSubmission[] @relation("SubmissionReviewer")
  outreachComments        OutreachComment[]    @relation("OutreachCommentAuthor")
  assets                  OutreachAsset[]      @relation("AssetUploader")
  campaignsOwned          Campaign[]           @relation("CampaignOwner")
  ownedContacts           OutreachContact[]    @relation("ContactOwner")
  contactInteractions     ContactInteraction[]
  recordedMetrics         PostMetric[]
  ownedRecurringTemplates RecurringTemplate[]  @relation("RecurringTemplateOwner")
  submissionApprovals     ApprovalRecord[]     @relation("SubmissionApprover")
  blogPosts               BlogPost[]           @relation("BlogPostCreator")
  blogRevisions           BlogRevision[]       @relation("BlogRevisionAuthor")
  blogAuthorships         BlogAuthor[]         @relation("BlogAuthorMember")
  blogSnippets            BlogSnippet[]        @relation("BlogSnippetCreator")

  // ── GitHub OAuth (per-member) ──
  // Access/refresh tokens are AES-GCM encrypted at rest (see backend/src/utils/crypto.ts).
  githubLogin          String?      @unique
  githubAccessToken    String?
  githubRefreshToken   String?
  githubTokenExpiresAt DateTime?
  createdGithubLinks   GitHubLink[] @relation("GitHubLinkActor")

  // ── Engagement (XP / doubloons / rank) ──
  xp                  Int                @default(0)
  doubloons           Int                @default(0)
  rank                Rank               @default(NESTLING)
  xpEvents            XpEvent[]
  doubloonEvents      DoubloonEvent[]
  cosmetics           MemberCosmetic[]
  pendingRewards      PendingReward[]
  avatarConfig        AvatarConfig?
  shopRotations       ShopRotation[]
  sentKudos           Kudos[]            @relation("KudosFrom")
  receivedKudos       Kudos[]            @relation("KudosTo")
  wishlistedCosmetics CosmeticWishlist[]

  // ── Streak / consumables / celebrations ──
  streak                Streak?
  dailyActivities       DailyActivity[]
  inventory             MemberInventory[]
  activeEffects         ActiveEffect[]
  weeklyBonusSends      Int       @default(0)
  weeklyBonusSendsWeek  DateTime? // ISO week start for which weeklyBonusSends applies
  celebrationConsumedAt DateTime? // last time the user dismissed a milestone celebration

  // ── Challenges / achievements ──
  memberChallenges    MemberChallenge[]
  memberAchievements  MemberAchievement[]
  rewardRolls         RewardRoll[]

  // ── Equipped rank-slot badge (separate from generic equippedSlot scheme so
  // we can render a default rank-derived SVG when null without a join). ──
  equippedBadgeId String?
  equippedBadge   Cosmetic? @relation("EquippedRankBadge", fields: [equippedBadgeId], references: [id], onDelete: SetNull)

  // Per-project progress snapshot the user last saw. Shape:
  //   { lastSeenAt: ISO, projects: { [projectId]: { pct, milestones: { [id]: pct } } } }
  // Animations on project mount diff this against the current pct to play a
  // "fill from where you left off" transition + pop recent contributor avatars.
  lastSeenProgress Json?

  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String?
  driveLink        String?
  slackChannel     String?
  slackChannelId   String?
  slackChannelName String?
  status           ProjectStatus @default(ACTIVE)
  type             ProjectType
  startDate        DateTime?
  targetDate       DateTime?
  programTag       String? // "astrousa" | "sa2tp" | "research" | "software" | "business" (for public archive grouping)
  pressKitToken    String?       @unique

  // ── GitHub link ──
  // githubRepo is "owner/repo" (mirrors driveLink). githubInstallId is the
  // GitHub App installation ID covering this repo; used for org-scoped reads
  // and webhooks so individual users' OAuth budgets aren't consumed.
  // githubBlockDoneOnCiFail (Phase 3): reject PATCH /tasks/:id when status
  // moves to DONE while a linked PR has failing checks.
  githubRepo              String?
  githubInstallId         Int?
  githubBlockDoneOnCiFail Boolean                     @default(true)
  githubLinks             GitHubLink[]
  githubMilestoneMaps     GitHubMilestoneMap[]
  tags                    Tag[]
  members                 ProjectMember[]
  tasks                   Task[]
  blockers                Blocker[]
  milestones              Milestone[]
  updates                 ProjectUpdate[]
  activities              Activity[]
  activityLogs            ActivityLog[]
  notificationTargets     ProjectNotificationTarget[]
  notifications           Notification[]
  events                  Event[]
  submissions             OutreachSubmission[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
}

model ProjectMember {
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String
  projectRole String   @default("Contributor")
  joinedAt    DateTime @default(now())

  @@id([projectId, memberId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    Priority      @default(MEDIUM)
  dueDate     DateTime?
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  assignees   Member[]      @relation("TaskAssignees")
  slackMsgTs  String?
  tags        Tag[]         @relation("TaskTags")
  // Each entry is { url: string, label?: string }. Stored as Json so we don't
  // need a separate table while keeping the structured shape the frontend uses.
  attachments Json          @default("[]")
  comments    TaskComment[]
  createdById String?
  createdBy   Member?       @relation("TaskCreator", fields: [createdById], references: [id])

  // ── Archive ──
  archivedAt      DateTime?
  archivedById    String?
  archivedBy      Member?   @relation("TaskArchiver", fields: [archivedById], references: [id])
  archiveNudgedAt DateTime?

  // ── Subtask hierarchy ──
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId String?
  subtasks     Task[]  @relation("TaskSubtasks")

  // ── Dependencies ──
  blockedBy TaskDependency[] @relation("TaskDependencies_blocked")
  blocks    TaskDependency[] @relation("TaskDependencies_blocking")

  // ── Category blockers ──
  blockers TaskBlocker[]

  // ── Progress ──
  progress TaskProgress @default(NO_PROGRESS)

  // ── Time tracking ──
  estimatedHours Float?
  storyPoints    Int?
  timeLogs       TimeLog[]

  // ── Recurring ──
  recurringInterval RecurringInterval?
  lastSpawnedAt     DateTime?
  escalatedAt       DateTime?
  sourceTaskId      String?
  isRecurring       Boolean            @default(false)
  recurrencePattern String?
  recurrenceEndDate DateTime?
  recurringParentId String?

  // ── Milestone ──
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  // ── Events ──
  priorityEvents Event[] @relation("EventPriorityTasks")

  activityLogs  ActivityLog[]
  notifications Notification[]

  githubLinks GitHubLink[]

  // ── Engagement idempotency ──
  // Set when handleTaskComplete first fires for this task. Subsequent DONE
  // transitions skip the grant (prevents DONE→IN_PROGRESS→DONE exploit).
  rewardGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([archivedAt])
}

model TaskComment {
  id        String        @id @default(cuid())
  content   String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  parentId  String?
  parent    TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentThread")
  editedAt  DateTime?
  reactions Json?
  createdAt DateTime      @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  dueDate     DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  tasks       Task[]
  status      MilestoneStatus @default(ON_TRACK)
  description String?
  ownerId     String?
  owner       Member?         @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  slackMsgTs  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, dueDate])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  entityId   String
  entityType String // "Task", "Project", "Milestone"
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String?
  member     Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([projectId])
  @@index([entityId])
  @@index([createdAt])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  authorId  String?
  author    Member?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  postedAt  DateTime @default(now())

  @@index([projectId])
}

// ── Activity Audit Log ───────────────────────────────────────
// Payload shapes by eventType:
//   TASK_CREATED         { taskTitle, priority, assigneeNames[] }
//   TASK_UPDATED         { taskTitle, changes[{ field, from, to }] }
//   TASK_COMPLETED       { taskTitle }
//   TASK_DELETED         { taskTitle }
//   TASK_ASSIGNED        { taskTitle, assigneeNames[] }
//   TASK_REASSIGNED      { taskTitle, fromName, toName }
//   TASK_SNOOZED         { taskTitle, newDueDate }
//   TASK_NOTE_ADDED      { taskTitle, preview }
//   TASK_SUBTASK_CREATED { parentTitle, subtaskTitle }
//   PROJECT_CREATED      { projectName }
//   PROJECT_UPDATED      { changes[{ field, from, to }] }
//   PROJECT_MEMBER_ADDED { memberName, role }
//   STANDUP_POSTED       { preview }

enum ActivitySource {
  WEB
  SLACK
}

enum ActivityEventType {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_SNOOZED
  TASK_NOTE_ADDED
  TASK_SUBTASK_CREATED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_MEMBER_ADDED
  STANDUP_POSTED
  GITHUB_REPO_LINKED
  GITHUB_ISSUE_LINKED
  GITHUB_ISSUE_IMPORTED
  GITHUB_BRANCH_CREATED
  GITHUB_PR_LINKED
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_REVIEW
  GITHUB_CI_PASSED
  GITHUB_CI_FAILED
  GITHUB_PUSH
  GITHUB_COMMIT_REFERENCED
  GITHUB_ISSUE_SYNCED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  BLOCKER_ASSIGNED
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
  TASK_BLOCKER_ATTACHED
  TASK_BLOCKER_DETACHED
  BLOCKER_RESOLVED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  TIME_LOGGED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_DELETED
  MILESTONE_TASKS_LINKED
  AI_PLAN_EXECUTED
}

enum GitHubLinkKind {
  ISSUE
  PR
  BRANCH
  COMMIT
  FILE
}

model ActivityLog {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  memberId  String?
  member    Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  source    ActivitySource
  eventType ActivityEventType
  payload   Json
  createdAt DateTime          @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId])
}

model ProjectNotificationTarget {
  id             String                 @id @default(cuid())
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  type           NotificationTargetType @default(CHANNEL)
  slackChannelId String
  eventTypes     String[]               @default([])
  createdAt      DateTime               @default(now())

  @@unique([projectId, slackChannelId])
  @@index([projectId])
  @@index([slackChannelId])
}

// ── GitHub link (Phase 2) ────────────────────────────────────
// Joins a Task (optional) and Project to a GitHub artifact (issue, PR,
// branch, commit, file). One Task can have many links of different kinds.

model GitHubLink {
  id           String         @id @default(cuid())
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String?
  kind         GitHubLinkKind
  repoFullName String
  refNumber    Int? // issue or PR number
  refSha       String? // commit SHA
  refPath      String? // branch name or file path
  state        String? // "open" | "closed" | "merged" | "draft"
  title        String?
  url          String
  externalId   String? // GitHub node ID for webhook join (Phase 3)
  lastSyncedAt DateTime?
  createdBy    Member?        @relation("GitHubLinkActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime       @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([repoFullName, kind])
}

// ── GitHub milestone mapping (Phase 4) ───────────────────────
// One row per ClubPM Milestone synced to a GitHub milestone in the project's
// linked repo. The repo is denormalized so the row remains valid after a
// repo re-link (older mappings stay queryable but inactive).

model GitHubMilestoneMap {
  id                    String    @id @default(cuid())
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String
  milestoneId           String    @unique
  githubMilestoneNumber Int
  repoFullName          String
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())

  @@index([projectId])
  @@index([repoFullName, githubMilestoneNumber])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6c5ce7")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskTags")
  createdAt DateTime @default(now())

  @@unique([name, projectId])
  @@index([projectId])
}

model TaskDependency {
  blockingTaskId String
  blockedTaskId  String
  reason         String?
  blockingTask   Task   @relation("TaskDependencies_blocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask    Task   @relation("TaskDependencies_blocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@id([blockingTaskId, blockedTaskId])
}

// Reusable non-task "category" blocker (e.g. "Order delays"), scoped to a
// project. Attaching one to a task forces it BLOCKED and rejects DONE until
// resolved (project-wide) or detached (per-task).
model Blocker {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  color      String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  tasks      TaskBlocker[]

  assigneeId String?
  assignee   Member? @relation("BlockerAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
}

model TaskBlocker {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  blockerId String
  blocker   Blocker  @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@id([taskId, blockerId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  recipient   Member           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Member?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId   String?
  message     String
  read        Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([projectId])
}

model TimeLog {
  id       String   @id @default(cuid())
  taskId   String
  memberId String
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])

  @@index([taskId])
  @@index([memberId])
}

// ── Events ───────────────────────────────────────────────────

enum EventType {
  MEETING
  DEADLINE
  WORKSHOP
  SOCIAL
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        EventType @default(MEETING)
  startTime   DateTime
  endTime     DateTime?
  location    String?
  isVirtual   Boolean   @default(false)

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  priorityTasks Task[] @relation("EventPriorityTasks")

  organizer   Member? @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  organizerId String?

  attendees Member[] @relation("EventAttendees")

  notes String?

  isRecurring       Boolean   @default(false)
  recurrencePattern String?
  recurrenceEndDate DateTime?

  submissions OutreachSubmission[]
  rsvps       EventRsvp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
  @@index([projectId])
  @@index([organizerId])
}

// ── Outreach ─────────────────────────────────────────────────

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum SubmissionType {
  SOCIAL_POST
  NEWSLETTER
  PHOTO
  VIDEO
  ANNOUNCEMENT
  EVENT_PROMO
}

model OutreachSubmission {
  id        String           @id @default(cuid())
  title     String
  type      SubmissionType
  status    SubmissionStatus @default(DRAFT)
  content   String?
  mediaUrls String[]
  platform  String[]

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  author   Member @relation("SubmissionAuthor", fields: [authorId], references: [id])
  authorId String

  reviewer   Member? @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId String?

  reviewNote      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformContent Json? // per-platform variants: { instagram: { caption, hashtags[], altText }, linkedin: { caption }, twitter: { caption }, ... }
  isTemplate      Boolean   @default(false)
  placeholders    Json? // [{ key: "memberName", description: "Who to feature" }]
  safetyReport    Json? // { safe: bool, issues: [{ category, severity, message, suggestedFix? }] }
  safetyCheckedAt DateTime?
  newsletterHtml  String? // Rich HTML for NEWSLETTER-type submissions
  videoScript     Json? // [{ shotNumber, durationSec, description, voiceover?, onScreenText? }]
  blogMarkdown    String? // AI-expanded long-form for /blog/:slug
  blogSlug        String?   @unique

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  comments        OutreachComment[]
  utmLinks        UtmLink[]
  metrics         PostMetric[]
  recurrences     RecurringTemplate[]
  approvals       ApprovalRecord[]
  newsletterSends NewsletterSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([projectId])
  @@index([campaignId])
}

model OutreachComment {
  id           String             @id @default(cuid())
  submissionId String
  submission   OutreachSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       Member             @relation("OutreachCommentAuthor", fields: [authorId], references: [id])
  body         String
  mentions     String[]
  parentId     String?
  parent       OutreachComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      OutreachComment[]  @relation("CommentReplies")
  // Draft annotations: a comment may instead be attached to a BlogPost (internal review notes).
  blogPostId   String?
  blogPost     BlogPost?          @relation("BlogPostAnnotations", fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@index([submissionId])
  @@index([blogPostId])
}

// ── Blog editor ──────────────────────────────────────────────

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  excerpt      String?
  status       BlogStatus @default(DRAFT)

  contentJson  Json // TipTap document — source of truth for editing + revision diffs
  contentYjs   Bytes? // Yjs/CRDT binary state for realtime collaboration
  renderedHtml String? // HTML snapshot written at publish time (served to the public site)

  coverImageUrl  String?
  readingTimeMin Int?

  // SEO / social
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?

  // Workflow
  scheduledAt DateTime?
  publishedAt DateTime?

  // Provenance
  sourceSubmissionId String? // set when created via the AI expand-to-blog flow
  createdById        String
  createdBy          Member  @relation("BlogPostCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authors     BlogAuthor[]
  revisions   BlogRevision[]
  tags        BlogTag[]         @relation("BlogPostTags")
  categories  BlogCategory[]    @relation("BlogPostCategories")
  annotations OutreachComment[] @relation("BlogPostAnnotations")

  @@index([status])
  @@index([slug])
}

model BlogRevision {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  contentJson Json
  title       String
  authorId    String
  author      Member   @relation("BlogRevisionAuthor", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([postId])
}

model BlogAuthor {
  id       String   @id @default(cuid())
  postId   String
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId String
  member   Member   @relation("BlogAuthorMember", fields: [memberId], references: [id])
  role     String? // e.g. "author", "editor"

  @@unique([postId, memberId])
  @@index([memberId])
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostTags")
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostCategories")
}

model BlogSnippet {
  id          String   @id @default(cuid())
  name        String
  contentJson Json
  createdById String
  createdBy   Member   @relation("BlogSnippetCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HashtagStat {
  id         String    @id @default(cuid())
  tag        String    @unique
  category   String?
  useCount   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model BrandVoice {
  id          String   @id @default(cuid())
  name        String
  description String
  examples    String[]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OutreachAsset {
  id           String   @id @default(cuid())
  name         String
  kind         String // "IMAGE" | "VIDEO" | "GRAPHIC" | "LOGO" | "DOC"
  url          String
  driveFileId  String?
  thumbnailUrl String?
  altText      String?
  tags         String[]
  uploadedById String
  uploadedBy   Member   @relation("AssetUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

model Campaign {
  id                String               @id @default(cuid())
  name              String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  goalType          String? // "RECRUITMENT" | "SPONSORSHIP" | "EVENT" | "AWARENESS"
  goalTarget        Int?
  goalProgress      Int                  @default(0)
  color             String? // hex for calendar/board chip
  ownerId           String
  owner             Member               @relation("CampaignOwner", fields: [ownerId], references: [id])
  requiredApprovers String[]             @default([]) // member IDs who must approve before APPROVED status
  slug              String?              @unique
  isPublic          Boolean              @default(false)
  submissions       OutreachSubmission[]
  contacts          OutreachContact[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([ownerId])
}

model OutreachContact {
  id              String               @id @default(cuid())
  name            String
  email           String?
  phone           String?
  organization    String?
  role            String?
  contactType     String // "SPONSOR" | "PRESS" | "PARTNER" | "PROSPECT" | "ALUMNI"
  stage           String               @default("COLD") // "COLD" | "CONTACTED" | "ENGAGED" | "ACTIVE" | "DORMANT"
  tags            String[]
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  ownerId         String?
  owner           Member?              @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  interactions    ContactInteraction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([contactType, stage])
  @@index([nextFollowUpAt])
  @@index([ownerId])
}

model ContactInteraction {
  id         String          @id @default(cuid())
  contactId  String
  contact    OutreachContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       String // "EMAIL" | "MEETING" | "CALL" | "NOTE" | "EVENT_ATTENDED"
  summary    String
  occurredAt DateTime        @default(now())
  memberId   String
  member     Member          @relation(fields: [memberId], references: [id])

  @@index([contactId])
}

model UtmLink {
  id           String              @id @default(cuid())
  code         String              @unique
  targetUrl    String
  submissionId String?
  submission   OutreachSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  platform     String? // "instagram" | "linkedin" | "twitter" | "newsletter" | "website"
  clicks       Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([submissionId])
}

model PostMetric {
  id           String             @id @default(cuid())
  submissionId String
  submission   OutreachSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  platform     String // "instagram" | "linkedin" | "twitter" | "website" | "newsletter"
  impressions  Int?
  likes        Int?
  comments     Int?
  shares       Int?
  clicks       Int?
  recordedAt   DateTime           @default(now())
  recordedById String
  recordedBy   Member             @relation(fields: [recordedById], references: [id])

  @@index([submissionId])
  @@index([platform])
  @@index([recordedAt])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  unsubscribeToken String    @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  source           String? // "import" | "self-signup" | "manual"
  createdAt        DateTime  @default(now())
}

model NewsletterSend {
  id             String             @id @default(cuid())
  submissionId   String
  submission     OutreachSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sentAt         DateTime           @default(now())
  recipientCount Int                @default(0)
  opens          Int                @default(0)
  clicks         Int                @default(0)

  @@index([submissionId])
}

model ApprovalRecord {
  id           String             @id @default(cuid())
  submissionId String
  submission   OutreachSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approverId   String
  approver     Member             @relation("SubmissionApprover", fields: [approverId], references: [id])
  approvedAt   DateTime           @default(now())
  comment      String?

  @@unique([submissionId, approverId])
  @@index([submissionId])
}

model RecurringTemplate {
  id                   String             @id @default(cuid())
  templateSubmissionId String
  templateSubmission   OutreachSubmission @relation(fields: [templateSubmissionId], references: [id], onDelete: Cascade)
  cronExpression       String
  defaultValues        Json? // map of placeholder key → default value
  active               Boolean            @default(true)
  nextRunAt            DateTime
  lastRunAt            DateTime?
  ownerId              String
  owner                Member             @relation("RecurringTemplateOwner", fields: [ownerId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([templateSubmissionId])
  @@index([active, nextRunAt])
}

model EventRsvp {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  member     Member?  @relation("MemberRsvps", fields: [memberId], references: [id], onDelete: SetNull)
  memberId   String?
  guestName  String?
  guestEmail String?
  rsvpAt     DateTime @default(now())
  attended   Boolean  @default(true)
  attendedAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@unique([eventId, guestEmail])
  @@index([eventId])
  @@index([memberId])
}

// ── Engagement / Gamification ────────────────────────────────

enum Rank {
  NESTLING
  FLEDGLING
  CADET
  SPECIALIST
  PIONEER
  COSMONAUT
  CELESTIAL
}

enum RewardEventType {
  TIME_LOG_HOUR
  TASK_COMPLETE_ADMIN_CREATED
  TASK_COMPLETE_MEMBER_CREATED
  MILESTONE_HIT
  KUDOS_RECEIVED
  BLOG_POST_PUBLISHED
  EARLY_DELIVERY_BONUS
}

enum XpSource {
  TIME_LOG
  TASK_COMPLETE
  MILESTONE
  KUDOS
  BLOG_POST
  ADMIN_ADJUSTMENT
  EARLY_BONUS
}

enum DoubloonSource {
  TIME_LOG
  TASK_COMPLETE
  MILESTONE
  KUDOS
  BLOG_POST
  SHOP_PURCHASE
  ADMIN_ADJUSTMENT
  EARLY_BONUS
}

enum CosmeticCategory {
  AVATAR_FEATURE
  CLOTHING
  NAME_FRAME
  DASHBOARD_THEME
  BADGE
  ANIMATION
  BORDER
}

enum CosmeticRarity {
  COMMON
  UNCOMMON
  RARE
  MYTHIC
}

enum PendingRewardStatus {
  PENDING
  APPROVED
  ADJUSTED
  REJECTED
}

model RewardEventConfig {
  id             String          @id @default(cuid())
  eventType      RewardEventType @unique
  autoApprove    Boolean         @default(true)
  xpAmount       Int             @default(0)
  doubloonAmount Int             @default(0)
  updatedAt      DateTime        @updatedAt
}

model XpEvent {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount       Int
  source       XpSource
  taskId       String?
  approvedById String?
  createdAt    DateTime @default(now())

  @@index([memberId, createdAt])
}

model DoubloonEvent {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Int // negative for spend
  source     DoubloonSource
  taskId     String?
  cosmeticId String?
  createdAt  DateTime       @default(now())

  @@index([memberId, createdAt])
}

model Cosmetic {
  id              String           @id @default(cuid())
  name            String
  description     String?
  category        CosmeticCategory
  rarity          CosmeticRarity
  cssSlug         String? // drives .theme-<slug>, .frame-<slug>, .anim-<slug>
  iconClass       String? // Font Awesome class for BADGE (legacy; svgUrl preferred)
  svgUrl          String? // public path to SVG artwork (e.g. /clubpm/badges/celestial.svg)
  registryKey     String? // key into CLOTHING / HAIR JS registries
  themeTokens     Json?   // { accent, accentSoft, glow, bgOverlay } for themes + tinted borders
  doubloonPrice   Int              @default(0)
  xpGate          Int? // null = no xp gate
  rankGate        Rank? // null = no rank gate
  shopEligible    Boolean          @default(true)
  unlockCondition String? // human-readable description (e.g. for badges)
  createdAt       DateTime         @default(now())

  members           MemberCosmetic[]
  wishlists         CosmeticWishlist[]
  equippedByMembers Member[]           @relation("EquippedRankBadge")

  @@index([category, rarity, shopEligible])
}

model MemberCosmetic {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cosmeticId   String
  cosmetic     Cosmetic @relation(fields: [cosmeticId], references: [id])
  equippedSlot String? // null = not equipped; e.g. "outfit", "hair", "theme", "frame", "animation"
  acquiredAt   DateTime @default(now())

  @@unique([memberId, cosmeticId])
  @@index([memberId, equippedSlot])
}

model CosmeticWishlist {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cosmeticId String
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([memberId, cosmeticId])
}

model ShopRotation {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime // truncated to day (UTC 00:00)
  slots     Json // { common: [id,id,id], uncommon: [id,id], rare: id|null, mythic: id|null }
  expiresAt DateTime

  @@unique([memberId, date])
}

model PendingReward {
  id                String              @id @default(cuid())
  memberId          String
  member            Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  taskId            String?
  eventType         RewardEventType
  proposedXp        Int
  proposedDoubloons Int
  status            PendingRewardStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  metadata          Json? // free-form context for the reviewer
  createdAt         DateTime            @default(now())

  @@index([status, createdAt])
}

model AvatarConfig {
  id                String   @id @default(cuid())
  memberId          String   @unique
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  featureJson       Json // VRM-era: { baseModelId, faceMorphs, bodyMorphs, colors, toggles }
  equippedCosmetics Json // { outfit, hair, theme, frame, animation } each cosmeticId|null
  portraitUrl       String? // cached PNG snapshot, written on Save; consumed by AvatarPortrait
  updatedAt         DateTime @updatedAt
}

model Kudos {
  id        String   @id @default(cuid())
  fromId    String
  from      Member   @relation("KudosFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Member   @relation("KudosTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String?
  createdAt DateTime @default(now())

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// ── Streak / engagement consumables ────────────────────────────

model Streak {
  id                    String    @id @default(cuid())
  memberId              String    @unique
  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActivityDate      DateTime? // UTC midnight of last qualifying activity day
  freezesUsedThisStreak Int       @default(0)
  updatedAt             DateTime  @updatedAt
}

model DailyActivity {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date          DateTime // UTC midnight of the activity day
  actionCount   Int      @default(0)
  firstActionAt DateTime @default(now())
  // True if this row represents a day covered by a Streak Freeze instead of
  // real activity. actionCount stays 0; the row exists so the heatmap can
  // mark frozen days visually distinct from both "kept" days and resets.
  wasFrozen     Boolean  @default(false)

  @@unique([memberId, date])
  @@index([memberId, date])
}

enum InventoryItemKey {
  STREAK_FREEZE
  XP_BOOST_24H
  KUDOS_REFILL
  SHOP_REROLL
}

model MemberInventory {
  id         String           @id @default(cuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemKey    InventoryItemKey
  quantity   Int              @default(0)
  acquiredAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([memberId, itemKey])
  @@index([memberId])
}

enum EffectKey {
  XP_BOOST_24H
  DOUBLOON_BOOST_24H
}

model ActiveEffect {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  effectKey  EffectKey
  multiplier Float     @default(1.0)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@unique([memberId, effectKey])
  @@index([memberId, expiresAt])
}

// ── Challenge / Achievement System ──────────────────────────────

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  ACHIEVEMENT
}

enum ChallengeCategory {
  KANBAN
  COMMENTS
  TIME
  FILES
  PROFILE
  CONTENT
  LEADERSHIP
  ELITE
  COLLABORATION
}

enum ChallengeMetric {
  TASK_COMPLETED
  TASK_CREATED_WITH_DETAILS
  TASK_MOVED_BACKLOG_TO_INPROGRESS
  TASK_MOVED_INPROGRESS_TO_DONE
  TASK_LABELED
  TASK_ASSIGNED_TO_TEAMMATE
  COMMENT_WRITTEN
  COMMENT_LONG
  COMMENT_REACTION
  STATUS_COMMENT
  TIME_LOG_ENTRY
  TIME_LOG_HOURS
  TIME_LOG_UNIQUE_TASKS
  TIME_LOG_WEEKDAY
  FILE_ATTACHED
  PROFILE_UPDATED
  BLOG_DRAFTED
  BLOG_PUBLISHED
  OUTREACH_DRAFTED
  OUTREACH_SUBMITTED
  DAILY_ACTIVE
  TASKS_NO_OVERDUE
  UNIQUE_ASSIGNEES
  UNIQUE_COMMENTERS_TARGETED
  KANBAN_COLUMN_COMPLETION
  ALL_MONTHLY_COMPLETE
  RANK_RARE_ACHIEVEMENTS_ALL
}

model Challenge {
  id             String            @id @default(cuid())
  key            String            @unique
  type           ChallengeType
  category       ChallengeCategory
  tier           CosmeticRarity?
  name           String
  description    String
  metricKey      ChallengeMetric
  target         Int
  xpReward       Int
  doubloonReward Int
  rollTableKey   String?
  active         Boolean           @default(true)
  iconClass      String?
  createdAt      DateTime          @default(now())

  memberChallenges   MemberChallenge[]
  memberAchievements MemberAchievement[]

  @@index([type, active])
}

model MemberChallenge {
  id          String    @id @default(cuid())
  memberId    String
  challengeId String
  periodStart DateTime
  periodEnd   DateTime
  progress    Int       @default(0)
  progressMeta Json?
  completedAt DateTime?
  claimedAt   DateTime?
  rolledItems Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([memberId, challengeId, periodStart])
  @@index([memberId, periodStart])
  @@index([memberId, completedAt])
}

model MemberAchievement {
  id          String    @id @default(cuid())
  memberId    String
  challengeId String
  unlockedAt  DateTime  @default(now())
  rolledItems Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([memberId, challengeId])
  @@index([memberId])
}

model RewardRoll {
  id         String   @id @default(cuid())
  memberId   String
  sourceType String
  sourceId   String
  tableKey   String
  rolled     Json
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}
