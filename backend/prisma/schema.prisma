model EventRsvp {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  member     Member?  @relation("MemberRsvps", fields: [memberId], references: [id], onDelete: SetNull)
  memberId   String?
  guestName  String?
  guestEmail String?
  rsvpAt     DateTime @default(now())
  attended   Boolean  @default(true)
  attendedAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@unique([eventId, guestEmail])
  @@index([eventId])
  @@index([memberId])
}

// ── Meeting Scheduler (when2meet-style availability polls) ───

enum MeetingPollStatus {
  OPEN
  FINALIZED
  CANCELED
}

enum MeetingPollAudience {
  INVITED // only invited members may respond
  PROJECT // whole project team may respond
  ANYONE // anyone with the link (members + guests)
}

model MeetingPoll {
  id          String  @id @default(cuid())
  publicToken String  @unique @default(cuid()) // shareable /schedule/:token link
  title       String
  description String?
  timezone    String  @default("America/New_York")

  // Candidate slots are stored as their canonical UTC start instants. The grid
  // is derived by grouping these by day; slotMinutes gives each slot's length.
  slotMinutes      Int        @default(30)
  slotStarts       DateTime[]
  responseDeadline DateTime? // soft: drives reminders + display only

  audience MeetingPollAudience @default(INVITED)
  status   MeetingPollStatus   @default(OPEN)

  // Escape hatch on top of `audience`: when true, anyone holding the share link
  // may submit availability (as a guest, or as themselves if signed in) even
  // though they are not in invitedMembers / not on the project.
  allowLinkResponses Boolean @default(false)

  organizer   Member? @relation("PollOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  organizerId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  priorityTasks  Task[]   @relation("PollPriorityTasks")
  invitedMembers Member[] @relation("PollInvitees")

  // Finalization: the winning slot + the Event it produced (kept linked).
  finalStart DateTime?
  finalEnd   DateTime?
  event      Event?    @relation("PollEvent", fields: [eventId], references: [id], onDelete: SetNull)
  eventId    String?   @unique

  reminderSentAt DateTime? // non-responder nudge idempotency
  responses      MeetingResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectId])
}

model MeetingResponse {
  id        String      @id @default(cuid())
  poll      MeetingPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  member    Member?     @relation("MemberPollResponses", fields: [memberId], references: [id], onDelete: SetNull)
  memberId  String?
  guestName String?

  slots    DateTime[] // subset of poll.slotStarts this respondent is available
  rewarded Boolean    @default(false) // XP granted once per member per poll

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pollId, memberId])
  @@index([pollId])
}

// ── Engagement / Gamification ────────────────────────────────

enum Rank {
  NESTLING
  FLEDGLING
  CADET
  SPECIALIST
  PIONEER
  COSMONAUT
  CELESTIAL
}

enum RewardEventType {
  TIME_LOG_HOUR
  TASK_COMPLETE_ADMIN_CREATED
  TASK_COMPLETE_MEMBER_CREATED
  MILESTONE_HIT
  KUDOS_RECEIVED
  BLOG_POST_PUBLISHED
  EARLY_DELIVERY_BONUS
  MEETING_AVAILABILITY_SUBMITTED
  COURSE_SECTION_COMPLETE
  COURSE_COMPLETE
}

enum XpSource {
  TIME_LOG
  TASK_COMPLETE
  MILESTONE
  KUDOS
  BLOG_POST
  ADMIN_ADJUSTMENT
  EARLY_BONUS
  MEETING
  COURSE
}

enum DoubloonSource {
  TIME_LOG
  TASK_COMPLETE
  MILESTONE
  KUDOS
  BLOG_POST
  SHOP_PURCHASE
  ADMIN_ADJUSTMENT
  EARLY_BONUS
  MEETING
  COURSE
}

enum CosmeticCategory {
  NAME_FRAME
  DASHBOARD_THEME
  BADGE
  ANIMATION
  BORDER
}

enum CosmeticRarity {
  COMMON
  UNCOMMON
  RARE
  MYTHIC
}

enum PendingRewardStatus {
  PENDING
  APPROVED
  ADJUSTED
  REJECTED
}

model RewardEventConfig {
  id             String          @id @default(cuid())
  eventType      RewardEventType @unique
  autoApprove    Boolean         @default(true)
  xpAmount       Int             @default(0)
  doubloonAmount Int             @default(0)
  updatedAt      DateTime        @updatedAt
}

model XpEvent {
