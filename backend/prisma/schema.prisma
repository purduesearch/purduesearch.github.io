// ── Outreach ─────────────────────────────────────────────────

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum SubmissionType {
  SOCIAL_POST
  NEWSLETTER
  PHOTO
  VIDEO
  ANNOUNCEMENT
  EVENT_PROMO
}

model OutreachSubmission {
  id        String           @id @default(cuid())
  title     String
  type      SubmissionType
  status    SubmissionStatus @default(DRAFT)
  content   String?
  mediaUrls String[]
  platform  String[]

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  author   Member @relation("SubmissionAuthor", fields: [authorId], references: [id])
  authorId String

  reviewer   Member? @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId String?

  reviewNote      String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformContent Json? // per-platform variants: { instagram: { caption, hashtags[], altText }, linkedin: { caption }, twitter: { caption }, ... }
  isTemplate      Boolean   @default(false)
  placeholders    Json? // [{ key: "memberName", description: "Who to feature" }]
  safetyReport    Json? // { safe: bool, issues: [{ category, severity, message, suggestedFix? }] }
  safetyCheckedAt DateTime?
  newsletterHtml  String? // Rich HTML for NEWSLETTER-type submissions
  videoScript     Json? // [{ shotNumber, durationSec, description, voiceover?, onScreenText? }]
  blogMarkdown    String? // AI-expanded long-form for /blog/:slug
  blogSlug        String?   @unique

  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  comments        OutreachComment[]
  utmLinks        UtmLink[]
  metrics         PostMetric[]
  recurrences     RecurringTemplate[]
  approvals       ApprovalRecord[]
  newsletterSends NewsletterSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([projectId])
  @@index([campaignId])
}

model OutreachComment {
  id           String              @id @default(cuid())
  // Exactly one of submissionId / blogPostId is set (outreach comment vs. blog draft annotation).
  submissionId String?
  submission   OutreachSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       Member              @relation("OutreachCommentAuthor", fields: [authorId], references: [id])
  body         String
  mentions     String[]
  parentId     String?
  parent       OutreachComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      OutreachComment[]   @relation("CommentReplies")
  // Draft annotations: a comment may instead be attached to a BlogPost (internal review notes).
  blogPostId   String?
  blogPost     BlogPost?           @relation("BlogPostAnnotations", fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@index([submissionId])
  @@index([blogPostId])
}

// ── Blog editor ──────────────────────────────────────────────

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id      String     @id @default(cuid())
  title   String
  slug    String     @unique
  excerpt String?
  status  BlogStatus @default(DRAFT)

  contentJson  Json // TipTap document — source of truth for editing + revision diffs
  contentYjs   Bytes? // Yjs/CRDT binary state for realtime collaboration
  renderedHtml String? // HTML snapshot written at publish time (served to the public site)
  theme        Json? // { accent, fontPair, width } — per-post Section Builder theme

  // Free-text byline (historical / non-member authors). Overrides createdBy when set.
  authorName String?
  // When set, this post's card links here instead of /blog/:slug (a "link post").
  linkUrl    String?

  coverImageUrl  String?
  readingTimeMin Int?

  // SEO / social
  metaDescription String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?

  // Workflow
  scheduledAt DateTime?
  publishedAt DateTime?

  // Provenance
  sourceSubmissionId String? // set when created via the AI expand-to-blog flow
  createdById        String
  createdBy          Member  @relation("BlogPostCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authors     BlogAuthor[]
  revisions   BlogRevision[]
  tags        BlogTag[]         @relation("BlogPostTags")
  categories  BlogCategory[]    @relation("BlogPostCategories")
  annotations OutreachComment[] @relation("BlogPostAnnotations")
  threads     BlogThread[]

  docAccessGrants  DocAccessGrant[]
  docShareSettings DocShareSettings?

  @@index([status])
  @@index([slug])
}

model BlogRevision {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  contentJson Json
  title       String
  // Optional human label ("Pre-launch draft"). When set it is what the history
  // drawer shows; the timestamp stays beneath it.
  name        String?
  authorId    String
  author      Member   @relation("BlogRevisionAuthor", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([postId])
}

model BlogAuthor {
  id       String   @id @default(cuid())
  postId   String
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId String
  member   Member   @relation("BlogAuthorMember", fields: [memberId], references: [id])

  @@unique([postId, memberId])
  @@index([memberId])
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostTags")
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostCategories")
}

model BlogSnippet {
  id          String   @id @default(cuid())
  name        String
  contentJson Json
  createdById String
  createdBy   Member   @relation("BlogSnippetCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogThread {
  id           String              @id @default(cuid())
  // Exactly one of postId / pressKitId / courseSectionId is set — enforced in
  // blogThreadService.
  postId          String?
  post            BlogPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  pressKitId      String?
  pressKit        ProjectPressKit? @relation(fields: [pressKitId], references: [id], onDelete: Cascade)
  courseSectionId String?
  courseSection   CourseSection?   @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  kind         BlogThreadKind
  status       BlogThreadStatus    @default(OPEN)
  origin       BlogThreadOrigin    @default(HUMAN)
  // Snapshot of the quoted text. The marks in the Y.Doc are the live anchor;
  // this lets an orphaned thread still show what it referred to.
  anchorText   String
  // COMMENT threads anchor here, as encoded Yjs relative positions, instead of
  // via a commentMark in the document: a comment is metadata ABOUT content, so
  // it must never reach contentJson, revisions, or markdown export. SUGGESTION
  // threads keep their marks — proposed text is content and belongs in the CRDT.
  anchorStart  Bytes?
  anchorEnd    Bytes?
  replaceWith  String? // SUGGESTION only: the proposal, denormalised for panel display
  rationale    String? // AI's stated reason, shown on the card
  createdById  String
  createdBy    Member              @relation("BlogThreadCreator", fields: [createdById], references: [id])
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  comments     BlogThreadComment[]

  @@index([postId, status])
  @@index([pressKitId, status])
  @@index([courseSectionId, status])
}

model BlogThreadComment {
  id        String     @id @default(cuid())
  threadId  String
  thread    BlogThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    Member     @relation("BlogThreadCommenter", fields: [authorId], references: [id])
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([threadId, createdAt])
}

enum PressKitStatus {
