generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Models ───────────────────────────────────────────────────

model session {
  sid    String   @id @db.VarChar(258)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  LEAD
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  ENGINEERING
  RESEARCH
  HYBRID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_ADDED
  SUBTASK_ADDED
  DEPENDENCY_ADDED
  MILESTONE_CREATED
  MILESTONE_COMPLETED
  PROJECT_UPDATED
  RECURRING_SPAWNED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationTargetType {
  CHANNEL
  DM
  GROUP_DM
}

enum TaskProgress {
  NO_PROGRESS
  IN_PROGRESS
  COMPLETED
}

enum MilestoneStatus {
  ON_TRACK
  AT_RISK
  BEHIND
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_MENTIONED
  TASK_DUE_SOON
  TASK_OVERDUE
  MILESTONE_COMPLETED
  MILESTONE_AT_RISK
  PROJECT_UPDATE
  STANDUP_POSTED
  COMMENT_REPLY
  SYSTEM
  GITHUB_PR_REVIEW_REQUESTED
  GITHUB_PR_MERGED
  GITHUB_CI_FAILED
  VAULT_CR_SUBMITTED
  VAULT_CR_DECIDED
  VAULT_CHECKIN
  MEETING_POLL_INVITE
  MEETING_POLL_FINALIZED
  MEETING_POLL_REMINDER
  BLOG_COMMENTED
}

enum BlogThreadKind {
  COMMENT
  SUGGESTION
}

enum BlogThreadStatus {
  OPEN
  RESOLVED
  ACCEPTED
  REJECTED
}

enum BlogThreadOrigin {
  HUMAN
  AI
}

// ── Models ───────────────────────────────────────────────────

model Member {
  id                      String               @id @default(cuid())
  slackId                 String               @unique
  slackHandle             String
  displayName             String
  avatarUrl               String?
  title                   String?
  email                   String?
  timezone                String?
  bio                     String?
  role                    Role                 @default(MEMBER)
  isAdmin                 Boolean              @default(false)
  isBot                   Boolean              @default(false)
  kanbanColumnOrder       String[]             @default(["TODO", "IN_PROGRESS", "BLOCKED", "DONE"])
  notificationPrefs       String[]             @default(["daily_reminders", "weekly_digest", "project_updates"])
  notificationChannels    Json?
  quietHoursStart         Int?
  quietHoursEnd           Int?
  mutedProjectIds         String[]             @default([])
  tasks                   Task[]               @relation("TaskAssignees")
  createdTasks            Task[]               @relation("TaskCreator")
  archivedTasks           Task[]               @relation("TaskArchiver")
  assignedBlockers        Blocker[]            @relation("BlockerAssignee")
  projects                ProjectMember[]
  comments                TaskComment[]
  activities              Activity[]
  notifications           Notification[]       @relation("NotificationRecipient")
  sentNotifications       Notification[]       @relation("NotificationActor")
  activityLogs            ActivityLog[]
  ownedMilestones         Milestone[]          @relation("MilestoneOwner")
  timeLogs                TimeLog[]
  updates                 ProjectUpdate[]
  organizedEvents         Event[]              @relation("EventOrganizer")
  attendedEvents          Event[]              @relation("EventAttendees")
  rsvps                   EventRsvp[]          @relation("MemberRsvps")
  organizedPolls          MeetingPoll[]        @relation("PollOrganizer")
  invitedPolls            MeetingPoll[]        @relation("PollInvitees")
  pollResponses           MeetingResponse[]    @relation("MemberPollResponses")
  submissions             OutreachSubmission[] @relation("SubmissionAuthor")
  reviewedSubmissions     OutreachSubmission[] @relation("SubmissionReviewer")
  outreachComments        OutreachComment[]    @relation("OutreachCommentAuthor")
  assets                  OutreachAsset[]      @relation("AssetUploader")
  campaignsOwned          Campaign[]           @relation("CampaignOwner")
  ownedContacts           OutreachContact[]    @relation("ContactOwner")
  contactInteractions     ContactInteraction[]
  recordedMetrics         PostMetric[]
  ownedRecurringTemplates RecurringTemplate[]  @relation("RecurringTemplateOwner")
  submissionApprovals     ApprovalRecord[]     @relation("SubmissionApprover")
  blogPosts               BlogPost[]           @relation("BlogPostCreator")
  blogRevisions           BlogRevision[]       @relation("BlogRevisionAuthor")
  courseSectionRevisions  CourseSectionRevision[] @relation("CourseSectionRevisionAuthor")
  blogAuthorships         BlogAuthor[]         @relation("BlogAuthorMember")
  blogSnippets            BlogSnippet[]        @relation("BlogSnippetCreator")
  pressKitsCreated        ProjectPressKit[]    @relation("PressKitCreator")
  pressKitRevisions       PressKitRevision[]   @relation("PressKitRevisionAuthor")
  blogThreadsCreated      BlogThread[]         @relation("BlogThreadCreator")
  blogThreadComments      BlogThreadComment[]  @relation("BlogThreadCommenter")

  // ── GitHub OAuth (per-member) ──
  // Access/refresh tokens are AES-GCM encrypted at rest (see backend/src/utils/crypto.ts).
  githubLogin          String?      @unique
  githubAccessToken    String?
  githubRefreshToken   String?
  githubTokenExpiresAt DateTime?
  createdGithubLinks   GitHubLink[] @relation("GitHubLinkActor")

  // ── Engagement (XP / doubloons / rank) ──
  xp                  Int                @default(0)
  doubloons           Int                @default(0)
  rank                Rank               @default(NESTLING)
  xpEvents            XpEvent[]
  doubloonEvents      DoubloonEvent[]
  cosmetics           MemberCosmetic[]
  pendingRewards      PendingReward[]
  shopRotations       ShopRotation[]
  sentKudos           Kudos[]            @relation("KudosFrom")
  receivedKudos       Kudos[]            @relation("KudosTo")
  wishlistedCosmetics CosmeticWishlist[]

  // ── Streak / consumables / celebrations ──
  streak                Streak?
  dailyActivities       DailyActivity[]
  inventory             MemberInventory[]
  activeEffects         ActiveEffect[]
  weeklyBonusSends      Int               @default(0)
  weeklyBonusSendsWeek  DateTime? // ISO week start for which weeklyBonusSends applies
  celebrationConsumedAt DateTime? // last time the user dismissed a milestone celebration

  // ── Challenges / achievements ──
  memberChallenges   MemberChallenge[]
  memberAchievements MemberAchievement[]
  rewardRolls        RewardRoll[]

  // ── Equipped rank-slot badge (separate from generic equippedSlot scheme so
  // we can render a default rank-derived SVG when null without a join). ──
  equippedBadgeId String?
  equippedBadge   Cosmetic? @relation("EquippedRankBadge", fields: [equippedBadgeId], references: [id], onDelete: SetNull)

  // Per-project progress snapshot the user last saw. Shape:
  //   { lastSeenAt: ISO, projects: { [projectId]: { pct, milestones: { [id]: pct } } } }
  // Animations on project mount diff this against the current pct to play a
  // "fill from where you left off" transition + pop recent contributor avatars.
  lastSeenProgress Json?

  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  // ── Constellation Vault (CAD change management) ──
  vaultCheckouts         VaultItem[]     @relation("VaultCheckout")
  createdVaultItems      VaultItem[]     @relation("VaultItemCreator")
  vaultVersionUploads    VaultVersion[]  @relation("VaultVersionUploader")
  authoredChangeRequests ChangeRequest[] @relation("ChangeRequestAuthor")
  reviewedChangeRequests ChangeRequest[] @relation("ChangeRequestReviewer")

  // ── Courses ──
  createdCourses    Course[]           @relation("CourseCreator")
  courseEnrollments CourseEnrollment[] @relation("CourseEnrollmentMember")
  assignedCourses   CourseEnrollment[] @relation("CourseEnrollmentAssigner")
  courseGenJobs     CourseGenJob[]     @relation("CourseGenJobCreator")
  workSubmissions   CourseWorkSubmission[]

  // ── Per-document access control ──
  docAccessGrants  DocAccessGrant[]   @relation("DocAccessMember")
  docAccessGranted DocAccessGrant[]   @relation("DocAccessGranter")
  docShareSet      DocShareSettings[] @relation("DocShareSetter")
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String?
  driveLink        String?
  slackChannel     String?
  slackChannelId   String?
  slackChannelName String?
  status           ProjectStatus @default(ACTIVE)
  type             ProjectType
  startDate        DateTime?
  targetDate       DateTime?
  programTag       String? // "astrousa" | "sa2tp" | "research" | "software" | "business" (for public archive grouping)
  pressKitToken    String?       @unique
  // Non-null means this is that member's private training project for the
  // onboarding course. The @unique is what makes ensureTrainingProject
  // idempotent by construction rather than by convention. Training projects are
  // excluded from every real listing — see Task 10.
  trainingForMemberId String? @unique

  // ── GitHub link ──
  // githubRepo is "owner/repo" (mirrors driveLink). githubInstallId is the
  // GitHub App installation ID covering this repo; used for org-scoped reads
  // and webhooks so individual users' OAuth budgets aren't consumed.
  // githubBlockDoneOnCiFail (Phase 3): reject PATCH /tasks/:id when status
  // moves to DONE while a linked PR has failing checks.
  githubRepo              String?
  githubInstallId         Int?
  githubBlockDoneOnCiFail Boolean                     @default(true)
  githubLinks             GitHubLink[]
  githubMilestoneMaps     GitHubMilestoneMap[]
  repos                   ProjectRepo[]
  tags                    Tag[]
  members                 ProjectMember[]
  tasks                   Task[]
  blockers                Blocker[]
  milestones              Milestone[]
  updates                 ProjectUpdate[]
  activities              Activity[]
  activityLogs            ActivityLog[]
  notificationTargets     ProjectNotificationTarget[]
  notifications           Notification[]
  events                  Event[]
  meetingPolls            MeetingPoll[]
  submissions             OutreachSubmission[]
  pressKit                ProjectPressKit?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  // ── Constellation Vault (CAD change management) ──
  vaultFolderId    String?
  vaultPartPrefix  String          @default("PRT")
  vaultPartCounter Int             @default(0)
  vaultCrCounter   Int             @default(0)
  vaultItems       VaultItem[]
  changeRequests   ChangeRequest[]
}

model ProjectMember {
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String
  projectRole String   @default("Contributor")
  joinedAt    DateTime @default(now())

  @@id([projectId, memberId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    Priority      @default(MEDIUM)
  dueDate     DateTime?
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  assignees   Member[]      @relation("TaskAssignees")
  slackMsgTs  String?
  tags        Tag[]         @relation("TaskTags")
  // Each entry is { url: string, label?: string }. Stored as Json so we don't
  // need a separate table while keeping the structured shape the frontend uses.
  attachments Json          @default("[]")
  comments    TaskComment[]
  createdById String?
  createdBy   Member?       @relation("TaskCreator", fields: [createdById], references: [id])

  // ── Archive ──
  archivedAt      DateTime?
  archivedById    String?
  archivedBy      Member?   @relation("TaskArchiver", fields: [archivedById], references: [id])
  archiveNudgedAt DateTime?

  // ── Subtask hierarchy ──
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId String?
  subtasks     Task[]  @relation("TaskSubtasks")

  // ── Dependencies ──
  blockedBy TaskDependency[] @relation("TaskDependencies_blocked")
  blocks    TaskDependency[] @relation("TaskDependencies_blocking")

  // ── Category blockers ──
  blockers TaskBlocker[]

  // ── Progress ──
  progress TaskProgress @default(NO_PROGRESS)

  // ── Time tracking ──
  estimatedHours Float?
  storyPoints    Int?
  timeLogs       TimeLog[]

  // ── Recurring ──
  recurringInterval RecurringInterval?
  lastSpawnedAt     DateTime?
  escalatedAt       DateTime?
  sourceTaskId      String?
  isRecurring       Boolean            @default(false)
  recurrencePattern String?
  recurrenceEndDate DateTime?
  recurringParentId String?

  // ── Milestone ──
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  // ── Events ──
  priorityEvents Event[]       @relation("EventPriorityTasks")
  priorityPolls  MeetingPoll[] @relation("PollPriorityTasks")

  activityLogs  ActivityLog[]
  notifications Notification[]

  githubLinks GitHubLink[]

  // ── Engagement idempotency ──
  // Set when handleTaskComplete first fires for this task. Subsequent DONE
  // transitions skip the grant (prevents DONE→IN_PROGRESS→DONE exploit).
  rewardGrantedAt DateTime?

  // ── Constellation Vault (CAD change management) ──
  changeRequests ChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([archivedAt])
}

model TaskComment {
  id        String        @id @default(cuid())
  content   String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  parentId  String?
  parent    TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentThread")
  editedAt  DateTime?
  reactions Json?
  createdAt DateTime      @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  dueDate     DateTime?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  tasks       Task[]
  status      MilestoneStatus @default(ON_TRACK)
  description String?
  ownerId     String?
  owner       Member?         @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  slackMsgTs  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, dueDate])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  entityId   String
  entityType String // "Task", "Project", "Milestone"
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String?
  member     Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([projectId])
  @@index([entityId])
  @@index([createdAt])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  authorId  String?
  author    Member?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  postedAt  DateTime @default(now())

  @@index([projectId])
}

// ── Activity Audit Log ───────────────────────────────────────
// Payload shapes by eventType:
//   TASK_CREATED         { taskTitle, priority, assigneeNames[] }
//   TASK_UPDATED         { taskTitle, changes[{ field, from, to }] }
//   TASK_COMPLETED       { taskTitle }
//   TASK_DELETED         { taskTitle }
//   TASK_ASSIGNED        { taskTitle, assigneeNames[] }
//   TASK_REASSIGNED      { taskTitle, fromName, toName }
//   TASK_SNOOZED         { taskTitle, newDueDate }
//   TASK_NOTE_ADDED      { taskTitle, preview }
//   TASK_SUBTASK_CREATED { parentTitle, subtaskTitle }
//   PROJECT_CREATED      { projectName }
//   PROJECT_UPDATED      { changes[{ field, from, to }] }
//   PROJECT_MEMBER_ADDED { memberName, role }
//   STANDUP_POSTED       { preview }

enum ActivitySource {
  WEB
  SLACK
}

enum ActivityEventType {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_SNOOZED
  TASK_NOTE_ADDED
  TASK_SUBTASK_CREATED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_MEMBER_ADDED
  STANDUP_POSTED
  GITHUB_REPO_LINKED
  GITHUB_ISSUE_LINKED
  GITHUB_ISSUE_IMPORTED
  GITHUB_BRANCH_CREATED
  GITHUB_PR_LINKED
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_REVIEW
  GITHUB_CI_PASSED
  GITHUB_CI_FAILED
  GITHUB_PUSH
  GITHUB_COMMIT_REFERENCED
  GITHUB_ISSUE_SYNCED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  BLOCKER_ASSIGNED
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
  TASK_BLOCKER_ATTACHED
  TASK_BLOCKER_DETACHED
  BLOCKER_RESOLVED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  TIME_LOGGED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_DELETED
  MILESTONE_TASKS_LINKED
  AI_PLAN_EXECUTED
  VAULT_ITEM_CREATED
  VAULT_ITEM_UPDATED
  VAULT_ITEM_DELETED
  VAULT_VERSION_CHECKED_IN
  VAULT_ITEM_CHECKED_OUT
  VAULT_CHECKOUT_RELEASED
  VAULT_ITEM_PROMOTED
  VAULT_REVISION_RELEASED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_UPDATED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  CHANGE_REQUEST_CANCELLED
  VAULT_BOM_LINK_ADDED
  VAULT_BOM_LINK_UPDATED
  VAULT_BOM_LINK_REMOVED
  TOUR_STEP_BROKEN
}

enum GitHubLinkKind {
  ISSUE
  PR
  BRANCH
  COMMIT
  FILE
}

model ActivityLog {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  memberId    String?
  member      Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  // Denormalized from payload.itemId so vault item history reads hit an index
  // instead of a JSON-path sequential scan (set automatically by logAuditEvent).
  vaultItemId String?
  source      ActivitySource
  eventType   ActivityEventType
  payload     Json
  createdAt   DateTime          @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId])
  @@index([vaultItemId])
}

model ProjectNotificationTarget {
  id             String                 @id @default(cuid())
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  type           NotificationTargetType @default(CHANNEL)
  slackChannelId String
  eventTypes     String[]               @default([])
  createdAt      DateTime               @default(now())

  @@unique([projectId, slackChannelId])
  @@index([projectId])
  @@index([slackChannelId])
}

// ── GitHub link (Phase 2) ────────────────────────────────────
// Joins a Task (optional) and Project to a GitHub artifact (issue, PR,
// branch, commit, file). One Task can have many links of different kinds.

model GitHubLink {
  id           String         @id @default(cuid())
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       String?
  kind         GitHubLinkKind
  repoFullName String
  refNumber    Int? // issue or PR number
  refSha       String? // commit SHA
  refPath      String? // branch name or file path
  state        String? // "open" | "closed" | "merged" | "draft"
  title        String?
  url          String
  externalId   String? // GitHub node ID for webhook join (Phase 3)
  lastSyncedAt DateTime?
  createdBy    Member?        @relation("GitHubLinkActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime       @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([repoFullName, kind])
}

// ── GitHub milestone mapping (Phase 4) ───────────────────────
// One row per ClubPM Milestone synced to a GitHub milestone in the project's
// linked repo. The repo is denormalized so the row remains valid after a
// repo re-link (older mappings stay queryable but inactive).

model GitHubMilestoneMap {
  id                    String       @id @default(cuid())
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId             String
  milestoneId           String       @unique
  githubMilestoneNumber Int
  repoFullName          String
  // Which linked repo (ProjectRepo) this mapping targets (multi-repo phase 1).
  // Nullable + SetNull so a repo removal doesn't cascade-delete history.
  projectRepo           ProjectRepo? @relation(fields: [projectRepoId], references: [id], onDelete: SetNull)
  projectRepoId         String?
  lastSyncedAt          DateTime?
  createdAt             DateTime     @default(now())

  @@index([projectId])
  @@index([repoFullName, githubMilestoneNumber])
}

// ── Multiple GitHub repos per project (Workstream B) ──────────
// All repos are fully equal (no "primary"). Project.githubRepo/githubInstallId/
// githubBlockDoneOnCiFail are kept temporarily for backward compatibility until
// all read paths move to ProjectRepo (see backend/scripts/backfillProjectRepos.ts).
model ProjectRepo {
  id                String               @id @default(cuid())
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  slug              String // "owner/repo"
  installId         Int? // per-repo GitHub App installation
  blockDoneOnCiFail Boolean              @default(true)
  createdById       String?
  createdAt         DateTime             @default(now())
  milestoneMaps     GitHubMilestoneMap[]

  @@unique([projectId, slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6c5ce7")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskTags")
  createdAt DateTime @default(now())

  @@unique([name, projectId])
  @@index([projectId])
}

model TaskDependency {
  blockingTaskId String
  blockedTaskId  String
  reason         String?
  blockingTask   Task    @relation("TaskDependencies_blocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask    Task    @relation("TaskDependencies_blocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@id([blockingTaskId, blockedTaskId])
}

// Reusable non-task "category" blocker (e.g. "Order delays"), scoped to a
// project. Attaching one to a task forces it BLOCKED and rejects DONE until
// resolved (project-wide) or detached (per-task).
model Blocker {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  color      String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  tasks      TaskBlocker[]

  assigneeId String?
  assignee   Member? @relation("BlockerAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
}

model TaskBlocker {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  blockerId String
  blocker   Blocker  @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@id([taskId, blockerId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  recipient   Member           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Member?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId   String?
  message     String
  read        Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([recipientId, read, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([projectId])
}

model TimeLog {
  id       String   @id @default(cuid())
  taskId   String
  memberId String
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])

  @@index([taskId])
  @@index([memberId])
}

// ── Events ───────────────────────────────────────────────────

enum EventType {
  MEETING
  DEADLINE
  WORKSHOP
  SOCIAL
  OTHER
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        EventType @default(MEETING)
  startTime   DateTime
