  @@index([memberId, createdAt])
}

model DoubloonEvent {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Int // negative for spend
  source     DoubloonSource
  taskId     String?
  cosmeticId String?
  createdAt  DateTime       @default(now())

  @@index([memberId, createdAt])
}

model Cosmetic {
  id              String           @id @default(cuid())
  name            String
  description     String?
  category        CosmeticCategory
  rarity          CosmeticRarity
  cssSlug         String? // drives .theme-<slug>, .frame-<slug>, .anim-<slug>
  iconClass       String? // Font Awesome class for BADGE (legacy; svgUrl preferred)
  svgUrl          String? // public path to SVG artwork (e.g. /clubpm/badges/celestial.svg)
  registryKey     String? // key into CLOTHING / HAIR JS registries
  themeTokens     Json? // { accent, accentSoft, glow, bgOverlay } for themes + tinted borders
  doubloonPrice   Int              @default(0)
  xpGate          Int? // null = no xp gate
  rankGate        Rank? // null = no rank gate
  shopEligible    Boolean          @default(true)
  unlockCondition String? // human-readable description (e.g. for badges)
  createdAt       DateTime         @default(now())

  members           MemberCosmetic[]
  wishlists         CosmeticWishlist[]
  equippedByMembers Member[]           @relation("EquippedRankBadge")

  @@index([category, rarity, shopEligible])
}

model MemberCosmetic {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cosmeticId   String
  cosmetic     Cosmetic @relation(fields: [cosmeticId], references: [id])
  equippedSlot String? // null = not equipped; e.g. "outfit", "hair", "theme", "frame", "animation"
  acquiredAt   DateTime @default(now())

  @@unique([memberId, cosmeticId])
  @@index([memberId, equippedSlot])
}

model CosmeticWishlist {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  cosmeticId String
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([memberId, cosmeticId])
}

model ShopRotation {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime // truncated to day (UTC 00:00)
  slots     Json // { common: [id,id,id], uncommon: [id,id], rare: id|null, mythic: id|null }
  expiresAt DateTime

  @@unique([memberId, date])
}

model PendingReward {
  id                String              @id @default(cuid())
  memberId          String
  member            Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  taskId            String?
  eventType         RewardEventType
  proposedXp        Int
  proposedDoubloons Int
  status            PendingRewardStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  metadata          Json? // free-form context for the reviewer
  createdAt         DateTime            @default(now())

  @@index([status, createdAt])
}

model Kudos {
  id        String   @id @default(cuid())
  fromId    String
  from      Member   @relation("KudosFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Member   @relation("KudosTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String?
  createdAt DateTime @default(now())

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// ── Streak / engagement consumables ────────────────────────────

model Streak {
  id                    String    @id @default(cuid())
  memberId              String    @unique
  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  lastActivityDate      DateTime? // UTC midnight of last qualifying activity day
  freezesUsedThisStreak Int       @default(0)
  updatedAt             DateTime  @updatedAt
}

model DailyActivity {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date          DateTime // UTC midnight of the activity day
  actionCount   Int      @default(0)
  firstActionAt DateTime @default(now())
  // True if this row represents a day covered by a Streak Freeze instead of
  // real activity. actionCount stays 0; the row exists so the heatmap can
  // mark frozen days visually distinct from both "kept" days and resets.
  wasFrozen     Boolean  @default(false)

  @@unique([memberId, date])
  @@index([memberId, date])
}

enum InventoryItemKey {
  STREAK_FREEZE
  XP_BOOST_24H
  KUDOS_REFILL
  SHOP_REROLL
}

model MemberInventory {
  id         String           @id @default(cuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemKey    InventoryItemKey
  quantity   Int              @default(0)
  acquiredAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([memberId, itemKey])
  @@index([memberId])
}

enum EffectKey {
  XP_BOOST_24H
  DOUBLOON_BOOST_24H
}

model ActiveEffect {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  effectKey  EffectKey
  multiplier Float     @default(1.0)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@unique([memberId, effectKey])
  @@index([memberId, expiresAt])
}

// ── Challenge / Achievement System ──────────────────────────────

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  ACHIEVEMENT
}

enum ChallengeCategory {
  KANBAN
  COMMENTS
  TIME
  FILES
  PROFILE
  CONTENT
  LEADERSHIP
  ELITE
  COLLABORATION
  LEARNING
}

enum ChallengeMetric {
  TASK_COMPLETED
  TASK_CREATED_WITH_DETAILS
  TASK_MOVED_BACKLOG_TO_INPROGRESS
  TASK_MOVED_INPROGRESS_TO_DONE
  TASK_LABELED
  TASK_ASSIGNED_TO_TEAMMATE
  COMMENT_WRITTEN
  COMMENT_LONG
  COMMENT_REACTION
  STATUS_COMMENT
  TIME_LOG_ENTRY
  TIME_LOG_HOURS
  TIME_LOG_UNIQUE_TASKS
  TIME_LOG_WEEKDAY
  FILE_ATTACHED
  PROFILE_UPDATED
  BLOG_DRAFTED
  BLOG_PUBLISHED
  OUTREACH_DRAFTED
  OUTREACH_SUBMITTED
  DAILY_ACTIVE
  TASKS_NO_OVERDUE
  UNIQUE_ASSIGNEES
  UNIQUE_COMMENTERS_TARGETED
  KANBAN_COLUMN_COMPLETION
  ALL_MONTHLY_COMPLETE
  RANK_RARE_ACHIEVEMENTS_ALL
  COURSE_SECTION_COMPLETED
  COURSE_COMPLETED
}

model Challenge {
  id             String            @id @default(cuid())
  key            String            @unique
  type           ChallengeType
  category       ChallengeCategory
  tier           CosmeticRarity?
  name           String
  description    String
  metricKey      ChallengeMetric
  target         Int
  xpReward       Int
  doubloonReward Int
  rollTableKey   String?
  active         Boolean           @default(true)
  iconClass      String?
  createdAt      DateTime          @default(now())

  memberChallenges   MemberChallenge[]
  memberAchievements MemberAchievement[]

  @@index([type, active])
}

model MemberChallenge {
  id           String    @id @default(cuid())
  memberId     String
  challengeId  String
  periodStart  DateTime
  periodEnd    DateTime
  progress     Int       @default(0)
  progressMeta Json?
  completedAt  DateTime?
  claimedAt    DateTime?
  rolledItems  Json?
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([memberId, challengeId, periodStart])
  @@index([memberId, periodStart])
  @@index([memberId, completedAt])
}

model MemberAchievement {
  id          String    @id @default(cuid())
  memberId    String
  challengeId String
  unlockedAt  DateTime  @default(now())
  rolledItems Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([memberId, challengeId])
  @@index([memberId])
}

model RewardRoll {
  id         String   @id @default(cuid())
  memberId   String
  sourceType String
  sourceId   String
  tableKey   String
  rolled     Json
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

// ── Constellation Vault (CAD change management) ──────────────

enum ChangeRequestStatus {
  OPEN
  APPROVED
  REJECTED
  CANCELLED
}

model VaultItem {
  id              String              @id @default(cuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  driveFolderId   String
  partNumber      String?
  currentRevision String?
  checkedOutById  String?
  checkedOutBy    Member?             @relation("VaultCheckout", fields: [checkedOutById], references: [id], onDelete: SetNull)
  checkedOutAt    DateTime?
  checkoutNote    String?
  createdById     String?
  createdBy       Member?             @relation("VaultItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  versions        VaultVersion[]
  crItems         ChangeRequestItem[]
  childLinks      VaultBomEdge[]      @relation("BomParent")
  parentLinks     VaultBomEdge[]      @relation("BomChild")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([projectId, partNumber])
  @@index([projectId, deletedAt])
}

model VaultVersion {
  id              String              @id @default(cuid())
  itemId          String
  item            VaultItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionNumber   Int
  driveFileId     String
  fileName        String
  mimeType        String?
  sizeBytes       Int?
  checksumMd5     String?
  note            String?
  uploadedById    String?
  uploadedBy      Member?             @relation("VaultVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  revision        String?
  releasedAt      DateTime?
  releasedByCrId  String?
  thumbnailFileId String?
  crItems         ChangeRequestItem[]
  createdAt       DateTime            @default(now())

  @@unique([itemId, versionNumber])
  // DB backstop for the approveCr serializable transaction: no two released
  // versions of one item may ever carry the same revision letter (NULLs are
  // distinct in Postgres, so unreleased versions are unaffected).
  @@unique([itemId, revision])
  @@index([itemId])
}

model ChangeRequest {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  description  String?
  status       ChangeRequestStatus @default(OPEN)
  authorId     String?
  author       Member?             @relation("ChangeRequestAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewerId   String?
  reviewer     Member?             @relation("ChangeRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  releaseNotes String?
  taskId       String?
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  items        ChangeRequestItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([projectId, number])
  @@index([projectId, status])
}

model ChangeRequestItem {
  id              String        @id @default(cuid())
  changeRequestId String
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  itemId          String
  item            VaultItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionId       String
  version         VaultVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  targetRevision  String
  note            String?

  @@unique([changeRequestId, itemId])
  @@index([itemId])
}

model VaultBomEdge {
  parentId  String
  parent    VaultItem @relation("BomParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     VaultItem @relation("BomChild", fields: [childId], references: [id], onDelete: Cascade)
  quantity  Int       @default(1)
  note      String?
  createdAt DateTime  @default(now())

  @@id([parentId, childId])
  @@index([childId])
}

// ── Google Drive bot account (Workstream A) ───────────────────
// Singleton (id is always "singleton") holding the OAuth refresh token for
// the single Drive "bot" account used for both viewing and uploading.
model GoogleDriveCredential {
  id            String   @id @default("singleton")
  refreshToken  String // encrypted via encryptSecret
  accountEmail  String
  scope         String
  connectedById String?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Courses (training / certification). Learners are club members only; sections
// reuse the blog TipTap editor + Yjs collab, so no new document nodes exist.
// ─────────────────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseSectionKind {
  CONTENT
  VIDEO
  QUIZ
  SLIDES
  WALKTHROUGH
  LIT_REVIEW
  ASSIGNMENT
}

enum CourseQuestionKind {
  SINGLE
  MULTI
  TRUE_FALSE
}

enum CourseProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  summary          String?
  coverImageUrl    String?
  status           CourseStatus @default(DRAFT)
  theme            Json?
  estimatedMinutes Int?
  // When set, these override the RewardEventConfig amounts for COURSE_COMPLETE.
  xpOverride       Int?
  doubloonOverride Int?
  createdById      String
  createdBy        Member       @relation("CourseCreator", fields: [createdById], references: [id])
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sections    CourseSection[]
  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@index([status])
  @@index([createdById])
}

model CourseModule {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order            Int
  title            String
  // The teaser line shown on a LOCKED module. Author-written, so it is safe to
  // serialize to a learner who cannot yet open the module's sections.
  summary          String?
  estimatedMinutes Int?
  isRequired       Boolean  @default(true)
  // When false, sections inside may be completed in any order. Defaults to true
  // so migrated courses keep their pre-module behavior exactly.
  sequential       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sections CourseSection[]

  // An index, NOT a unique constraint — saveStructure rewrites the whole set in
  // one transaction, which a unique constraint would force into a two-pass
  // shuffle. Same reasoning as CourseSection's.
  @@index([courseId, order])
}

model CourseSection {
  id            String            @id @default(cuid())
  courseId      String
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId      String
  module        CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  kind          CourseSectionKind @default(CONTENT)
  isRequired    Boolean           @default(true)
  contentJson   Json
  contentYjs    Bytes?
  // VIDEO: { youtubeId, allowedRates[], lockSeek, ... }
  videoConfig   Json?
  // SLIDES: { sourceKind, sourceName, audioUrl, audioFileId, audioDurationSec, autoAdvance }
  // One JSON column, like videoConfig — every writer spreads the previous value
  // so a partial save cannot drop keys it does not own.
  slideConfig   Json?
  // WALKTHROUGH: { tourId, entryRoute, requiresTrainingProject, stepCount }
  // One JSON column, same idiom as videoConfig / slideConfig — every writer
  // spreads the previous value so a partial save cannot drop keys it does not own.
  tourConfig    Json?
  // LIT_REVIEW: { pdfDriveFileId, pdfTitle, citation, promptText, minWords,
  //               referenceSummary, rubric: [{ id, point, weight }] }
  // Same one-column idiom as videoConfig / slideConfig / tourConfig: every
  // writer spreads the previous value so a partial save cannot drop keys it
  // does not own.
  //
  // `referenceSummary` and `rubric` are AUTHOR-ONLY. The learner payload builds
  // its own object from the safe keys (see sanitizeLitConfig) rather than
  // deleting the secret ones off this column.
  litConfig     Json?
  // ASSIGNMENT: { promptText, handoutDriveFileId, handoutName, handoutMimeType,
  //               minWords, referenceAnswer, rubric: [{ id, point, weight }] }
  // Same one-column idiom as videoConfig / slideConfig / tourConfig / litConfig:
  // every writer spreads the previous value so a partial save cannot drop keys
  // it does not own.
  //
  // `referenceAnswer` and `rubric` are AUTHOR-ONLY. The learner payload builds
  // its own object from the safe keys (see sanitizeAssignmentConfig) rather than
  // deleting the secret ones off this column.
  assignmentConfig Json?
  // QUIZ only
  passThreshold Int?
  maxAttempts   Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  questions CourseQuestion[]
  slides    CourseSlide[]
  progress  CourseSectionProgress[]
  attempts  CourseQuizAttempt[]
  threads   BlogThread[]
  revisions CourseSectionRevision[]

  workSubmissions CourseWorkSubmission[]

  docAccessGrants  DocAccessGrant[]
  docShareSettings DocShareSettings?

  // Deliberately an index, NOT a unique constraint: reorderSections rewrites the
  // whole set in one transaction, which a unique constraint would force into an
  // ugly two-pass shuffle.
  //
  // `order` is order WITHIN the module, not within the course.
  @@index([moduleId, order])
}

/// Point-in-time snapshot of a section's body, mirroring BlogRevision.
///
/// Course sections had no history at all, which is why a bug that overwrote
/// `contentJson` with an empty document destroyed two written ares-101
/// articles with nothing to roll back to. `updateSection` now snapshots the
/// OUTGOING body before replacing it (throttled — see SNAPSHOT_THROTTLE_MS),
/// so the same class of accident is recoverable rather than terminal.
model CourseSectionRevision {
  id          String        @id @default(cuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentJson Json
  title       String
  /// Optional human label ("Before the rewrite"). When set it is what the
  /// history drawer shows, with the timestamp beneath it.
  name        String?
  /// Nullable, unlike BlogRevision.authorId: a snapshot can be taken by the
  /// seeder or a scheduled job, which is not a member.
  authorId    String?
  author      Member?       @relation("CourseSectionRevisionAuthor", fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([sectionId, createdAt])
}

model CourseQuestion {
  id                String             @id @default(cuid())
  sectionId         String
  section           CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order             Int
  prompt            String
  kind              CourseQuestionKind @default(SINGLE)
  explanation       String?
  points            Int                @default(1)
  // null → quiz-section question; non-null → in-video pop-up at this timestamp.
  videoTimestampSec Int?
  // null → quiz/pop-up question; non-null → overlay on this slide of a SLIDES
  // section. A row has at most one of slideIndex / videoTimestampSec set.
  slideIndex        Int?
  rewindToSec       Int?

  answers   CourseAnswer[]
  responses CourseQuestionResponse[]

  @@index([sectionId, order])
}

model CourseAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  // Never serialized into a learner-facing payload.
  isCorrect  Boolean        @default(false)

  @@index([questionId, order])
}

model CourseSlide {
  id          String        @id @default(cuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  index       Int
  // Drive direct-view URL. Public-but-unguessable, like every blog image; the
  // gate protects sequencing by withholding the URL, not by ACL.
  imageUrl    String
  // Kept so a re-import can delete exactly what it replaces.
  imageFileId String
  text        String?
  notes       String?
  startSec    Int?
  width       Int?
  height      Int?

  @@index([sectionId, index])
}

/// One learner's attempt at a LIT_REVIEW or ASSIGNMENT section.
///
/// Named for "work submitted", not for the literature review it started as:
/// ASSIGNMENT sections write rows here too, so one grading pipeline, one
/// history drawer, and one officer progress column serve both kinds.
///
/// @@map pins the original table name, so the rename emits no DDL.
model CourseWorkSubmission {
  id           String        @id @default(cuid())
  sectionId    String
  section      CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  text         String
  wordCount    Int
  // Null for a pasted answer. The uploaded file itself is discarded after
  // extraction — these two keep a record of WHAT was turned in.
  fileName     String?
  fileMimeType String?
  // Null means grading has not run — a PENDING grade, never a failed one. Under
  // a score gate this is the fail-open case: the section completes anyway and is
  // flagged to officers. See the design doc §5.
  feedbackJson Json?
  gradedAt     DateTime?
  createdAt    DateTime      @default(now())

  // One row PER ATTEMPT, never updated in place. A member who resubmits after
  // reading their feedback produces a second row; that revision history is the
  // most interesting thing these sections produce.
  @@index([sectionId, memberId])
  @@map("CourseLitSubmission")
}

model CourseEnrollment {
  id              String    @id @default(cuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member    @relation("CourseEnrollmentMember", fields: [memberId], references: [id], onDelete: Cascade)
  assignedById    String?
  assignedBy      Member?   @relation("CourseEnrollmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  // XP idempotency gate, mirroring Task.rewardGrantedAt — never clear it or a
  // re-completion re-grants course XP.
  rewardGrantedAt DateTime?
  lastSectionId   String?

  sectionProgress CourseSectionProgress[]
  quizAttempts    CourseQuizAttempt[]

  @@unique([courseId, memberId])
  @@index([memberId])
}

model CourseSectionProgress {
  id               String               @id @default(cuid())
  enrollmentId     String
  enrollment       CourseEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sectionId        String
  section          CourseSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status           CourseProgressStatus @default(NOT_STARTED)
  // Server-clamped high-water mark for VIDEO sections.
  maxWatchedSec    Int                  @default(0)
  // Server-clamped high-water mark for SLIDES sections.
  maxSlideIndex    Int                  @default(0)
  // Server-clamped high-water mark for WALKTHROUGH sections.
  maxStepIndex     Int                  @default(0)
  answeredPopupIds String[]             @default([])
  completedAt      DateTime?
  // XP idempotency gate, mirroring Task.rewardGrantedAt.
  rewardGrantedAt  DateTime?

  @@unique([enrollmentId, sectionId])
  @@index([sectionId])
}

model CourseQuizAttempt {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sectionId    String
  section      CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  startedAt    DateTime         @default(now())
  submittedAt  DateTime?
  scorePct     Float?
  passed       Boolean          @default(false)

  responses CourseQuestionResponse[]

  @@index([enrollmentId, sectionId])
}

model CourseQuestionResponse {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    CourseQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   CourseQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerIds  String[]          @default([])
  isCorrect  Boolean           @default(false)

  @@index([attemptId])
  // Powers admin item analysis (per-question pass rates).
  @@index([questionId])
}

enum CourseGenStatus {
  OUTLINING
  AWAITING_REVIEW
  GENERATING
  DONE
  FAILED
}

model CourseGenJob {
  id            String          @id @default(cuid())
  createdById   String
  createdBy     Member          @relation("CourseGenJobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status        CourseGenStatus @default(OUTLINING)
  prompt        String
  reference     String?
  sourcePostIds String[]        @default([])
  // A validated CoursePlan (see coursePlan.ts), editable by the author while
  // AWAITING_REVIEW.
  outline       Json?
  // Set once stage 2 has created the course — including on a cancelled run,
  // where the partial course is deliberately kept.
  courseId      String?
  progress      Int             @default(0)
  stepLabel     String?
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([createdById, createdAt])
}

// ── Per-document access control ───────────────────────────────────────────
// One grant/settings row targets exactly one document. Prisma cannot express
// "exactly one FK set", so a num_nonnulls CHECK constraint in the migration
// enforces it — see prisma/migrations/*_doc_access/migration.sql.

enum DocAccessLevel {
  VIEW
  COMMENT
  EDIT
  OWNER
}

model DocAccessGrant {
  id              String           @id @default(cuid())
  postId          String?
  post            BlogPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  pressKitId      String?
  pressKit        ProjectPressKit? @relation(fields: [pressKitId], references: [id], onDelete: Cascade)
  courseSectionId String?
  courseSection   CourseSection?   @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)

  memberId    String
  member      Member         @relation("DocAccessMember", fields: [memberId], references: [id], onDelete: Cascade)
  level       DocAccessLevel
  grantedById String
  grantedBy   Member         @relation("DocAccessGranter", fields: [grantedById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([postId, memberId])
  @@unique([pressKitId, memberId])
  @@unique([courseSectionId, memberId])
  @@index([memberId])
}

model DocShareSettings {
  id              String           @id @default(cuid())
  postId          String?          @unique
  post            BlogPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  pressKitId      String?          @unique
  pressKit        ProjectPressKit? @relation(fields: [pressKitId], references: [id], onDelete: Cascade)
  courseSectionId String?          @unique
  courseSection   CourseSection?   @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)

  clubLevel DocAccessLevel
  setById   String
  setBy     Member         @relation("DocShareSetter", fields: [setById], references: [id])
  updatedAt DateTime       @updatedAt
}
