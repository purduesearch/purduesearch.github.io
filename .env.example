# Copy this file to backend/.env and fill in the values.
# For production on Oracle, set NODE_ENV=production and update URLs accordingly.

# ── Environment ───────────────────────────────────────────────
# local dev:  NODE_ENV=development
# Oracle:     NODE_ENV=production
NODE_ENV=development

# ── Server ────────────────────────────────────────────────────
# local dev:  PORT=3001, BACKEND_URL=http://localhost:3001
# Oracle:     PORT=3001, BACKEND_URL=https://api.purduesearch.org
PORT=3001
BACKEND_URL=http://localhost:3001

# ── Frontend ──────────────────────────────────────────────────
# The CANONICAL public origin. Must stay single-valued: ~10 modules read it to
# build outbound links (Slack deep links, OAuth redirects). Put additional
# CORS-only origins in CORS_EXTRA_ORIGINS below, never here.
# local dev:  FRONTEND_URL=http://localhost:3000
# Oracle:     FRONTEND_URL=https://purduesearch.org
FRONTEND_URL=http://localhost:3000

# Extra origins accepted by CORS, comma-separated. Optional; empty by default.
# Used during a domain migration so the old and new front ends both work:
#   CORS_EXTRA_ORIGINS=https://purduesearch.github.io
# Clear it once the old origin is retired.
CORS_EXTRA_ORIGINS=

# Public base URL used for shareable links (meeting-scheduler /schedule/:token).
# Defaults to https://purduesearch.org when unset.
APP_BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# local dev:  use docker-compose postgres
# Oracle:     use the server's local postgres socket or connection string
DATABASE_URL=postgresql://clubpm:clubpm_dev@localhost:5432/club_pm

# ── Session ───────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string

# ── Slack App Credentials ─────────────────────────────────────
# Bot token (xoxb-...) — found under OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing secret — found under Basic Information
SLACK_SIGNING_SECRET=your-signing-secret

# App-level token (xapp-...) — required for Socket Mode
# Create one under Basic Information → App-Level Tokens with connections:write scope
SLACK_APP_TOKEN=xapp-your-app-token

# OAuth client credentials — found under Basic Information → App Credentials
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret

# ── Leadership channel ────────────────────────────────────────
# Members of this channel are granted admin (project creation) rights.
# Accepts a channel name ("leadership") or a raw Slack channel ID ("C0123456789")
LEADERSHIP_CHANNEL_ID=leadership

# ── AI / Google ───────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Standard lane — most AI features. Also the fallback for the two lanes below.
GEMINI_MODEL=gemini-2.0-flash-lite
# Reasoning lane (25 req/day): "Ask" about a post, whole-post AI edits, AI action
# plans, the weekly risk/capacity reports. Optional, but set it to a real model id
# you have access to — a wrong id silently degrades every complex-lane feature to
# the standard model. Leave unset to use GEMINI_MODEL for these too.
GEMINI_COMPLEX_MODEL=
# Low-latency lane for inline editor autocomplete. Falls back to GEMINI_MODEL.
GEMINI_FAST_MODEL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json
AI_CACHE_TTL_SECONDS=300

CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# ── GitHub App + OAuth (free tier) ───────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
# Vault repositories require Contents read/write for App-token Git + LFS transport.
# Other GitHub panels may use: Issues (R), Pull requests (R), Metadata (R), Checks (R).
# OAuth scopes: read:user, user:email, repo (private repo read), read:org
# Callback URL: ${BACKEND_URL}/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=         # base64-encoded PEM (mirrors GOOGLE_SERVICE_ACCOUNT_KEY pattern)

# Phase 0 Vault inventory planning only (backend/scripts/vault-inventory.ts).
# Examples, not a billing guarantee; use the repository owner's current LFS plan.
VAULT_EST_MONTHLY_DOWNLOADS=2
VAULT_EST_MONTHLY_NEW_GIB=1
# Maximum Vault source upload in MiB (both legacy and GitHub routes; default 512).
VAULT_MAX_UPLOAD_MB=512
VAULT_JOB_DIR=uploads/vault-jobs  # durable local volume; do not use ephemeral container storage
VAULT_RELEASE_DIR=uploads/vault-releases  # cached release packages; safe to lose (rebuilt from pinned manifests), keep off ephemeral storage for large assemblies
VAULT_CUTOVER_AUTHORITY=  # separate high-entropy operator secret; required with admin auth for freeze/activate/rollback
VAULT_DRIVE_RETENTION_DAYS=30  # owner-approved interval after verified cutover; never triggers automatic deletion
# Phase 9 geometry diff (STL/OBJ/glTF/GLB/STEP). One diff runs per process, in a worker thread.
VAULT_GEOMETRY_DIR=uploads/vault-geometry  # converted STEP meshes; derived data, safe to lose
VAULT_GEOMETRY_MAX_MB=256  # per-file cap, checked before any bytes are fetched
VAULT_GEOMETRY_MAX_TRIANGLES=3000000
VAULT_GEOMETRY_TIMEOUT_MS=180000  # wall-clock limit per diff; a timeout is stored, not retried
VAULT_GEOMETRY_WORKER_MB=2048  # V8 heap limit of the diff worker thread
VAULT_GEOMETRY_RETENTION_DAYS=90  # cached results and meshes older than this are pruned and recomputed on demand
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=          # Phase 3 — random string set on the App webhook config
# Local dev webhook tunnelling (Phase 3): forward GitHub deliveries via smee.io.
# 1. Create a channel: https://smee.io/new — copy the URL (e.g. https://smee.io/xxxx).
# 2. In your GitHub App's webhook config, set "Webhook URL" to that smee URL
#    and "Secret" to the value of GITHUB_WEBHOOK_SECRET above.
# 3. Locally run:  npx smee-client -u https://smee.io/xxxx -t http://localhost:3001/api/github/webhook

# 32-byte hex key — encrypts OAuth tokens at rest. Generate with:
#   openssl rand -hex 32
INTEGRATION_TOKEN_KEY=
